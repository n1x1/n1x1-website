{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ForticaDashboard.jsx",
              "ForticaLogin.jsx",
              "ForticaProperty.jsx",
              "ForticaShared.jsx",
              "components/buttons/**",
              "components/cards/**",
              "components/forms/**",
              "components/icon/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SF Pro Display|SF Pro Text|Inter))/i]",
        "message": "Font not provided by the design system. Available: SF Pro Display, SF Pro Text, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, as, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfigChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|delta|thumb|swatch|selected|key|ref|className|style|children)$/]",
        "message": "<ConfigChip> doesn't accept that prop. Declared props: label, delta, thumb, swatch, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onSearch|onBag|key|ref|className|style|children)$/]",
        "message": "<GlobalNav> doesn't accept that prop. Declared props: items, onSearch, onBag."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:translucent|solid)$/]",
        "message": "<IconButton> variant must be one of 'translucent' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|tagline|primaryLabel|secondaryLabel|onPrimary|onSecondary|image|imageAlt|mode|align|children|key|ref|className|style|children)$/]",
        "message": "<ProductTile> doesn't accept that prop. Declared props: eyebrow, headline, tagline, primaryLabel, secondaryLabel, onPrimary, onSecondary, image, imageAlt, mode, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<ProductTile> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|name|price|linkLabel|onLink|badge|key|ref|className|style|children)$/]",
        "message": "<StoreCard> doesn't accept that prop. Declared props: image, imageAlt, name, price, linkLabel, onLink, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|links|ctaLabel|onCta|key|ref|className|style|children)$/]",
        "message": "<SubNav> doesn't accept that prop. Declared props: category, links, ctaLabel, onCta."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
